# GARUDA Environment Configuration

# Application
APP_NAME=GARUDA
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite:///./storage/garuda.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=storage/logs

# Storage
STORAGE_DIR=storage
CACHE_DIR=storage/cache
TEMP_DIR=storage/temp
EXPORT_DIR=storage/exports

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
